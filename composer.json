{
    "name": "splicewire/laravel-beam-tenancy",
    "description": "The multi-tenancy substrate of the beam stack: the central Tenant model, seat and invitation primitives, Postgres schema-per-tenant storage, tenancy bootstrappers, and the designated system-tenant resolver.",
    "type": "library",
    "license": "MIT",
    "replace": {
        "splicewire/laravel-satellite-multi-tenancy": "self.version"
    },
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-model-status": "*",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "*",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-sitemap": "*",
        "stancl/tenancy": "^3.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "stancl/virtualcolumn": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Tenancy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Tenancy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Tenancy\\BeamMultiTenancyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
