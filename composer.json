{
    "name": "splicewire/laravel-beam-tenancy",
    "description": "The multi-tenancy substrate of the beam stack: the central Tenant model, seat and invitation primitives, Postgres schema-per-tenant storage, tenancy bootstrappers, and the designated system-tenant resolver.",
    "type": "library",
    "license": "MIT",
    "replace": {
        "splicewire/laravel-satellite-multi-tenancy": "self.version"
    },
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-popcorn": "dev-main",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.0|^5.0",
        "spatie/laravel-model-status": "*",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "*",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-accounts": "*",
        "splicewire/laravel-beam-provision": "*",
        "splicewire/laravel-beam-sitemap": "*",
        "splicewire/laravel-beam-workflows": "*",
        "stancl/tenancy": "^3.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "rushing/laravel-schema-convergence": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "stancl/virtualcolumn": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1",
        "rushing/php-graphine": "dev-main",
        "nikic/php-parser": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Tenancy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Tenancy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Tenancy\\BeamTenancyServiceProvider"
            ]
        },
        "package-topology": {
            "because": "beam-tenancy is the tenancy substrate. It depends DOWN on beam and on beam-accounts (Tenant IS a TeamContract and uses the account engine's HasMembers/Role) and is depended ON by beam-commerce, so the commerce edge can only ever run one way: a tenancy->commerce require would close a cycle. Tenant's billing-account relation therefore resolves through the beam.tenancy.billing_account_model seam rather than naming a commerce class.",
            "mustRequire": [
                "splicewire/laravel-beam",
                "splicewire/laravel-beam-accounts",
                "splicewire/laravel-beam-workflows"
            ],
            "mustNotRequire": [
                "splicewire/laravel-satellite",
                "splicewire/tower"
            ],
            "neverReaches": [
                "splicewire/laravel-beam-commerce"
            ],
            "sourceNeverReferences": [
                "Splicewire\\Beam\\Commerce\\"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-graphine.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-accounts.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-provision.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-sitemap.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-workflows.git"
        }
    ]
}
